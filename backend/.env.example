# CodeDNA Backend — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Google Gemini Flash ────────────────────────────────────────────────────────
# Free tier: 15 RPM, 1M TPM — no billing required
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Model name selection (default: gemini-3.5-flash-lite for instant response and zero 503 load issues).
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── GitHub Access Token ─────────────────────────────────────────────────────────
# Optional: Personal Access Token to increase GitHub discovery rate limit from 60 to 5,000 requests/hr
GITHUB_TOKEN=your_github_pat_token_here
# ─── CORS Security Settings ──────────────────────────────────────────────────────
# Comma-separated allowed origins (default: http://localhost:3000,http://127.0.0.1:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
